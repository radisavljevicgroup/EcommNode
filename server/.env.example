PORT=4000
# Optional: locks CORS to one origin. Leave unset in dev to allow any
# http://localhost:<port> origin (Vite may pick a different port).
# CLIENT_ORIGIN=http://localhost:5173

# Supabase project URL (same value as app/.env's VITE_SUPABASE_URL) and the
# service role (secret) key — Supabase dashboard → Settings → API. Needed
# only for the "add worker" endpoint, which creates auth users and bypasses
# RLS to write into another user's profile row. Never expose this key to
# the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# "Poveži se sa Google nalogom" for GA4 and Search Console
# (lib/googleOAuthClient.js, routes/ga4.js + routes/gsc.js + the shared
# routes/googleOAuth.js callback) — OAuth 2.0 Client ID (type "Web
# application") from Google Cloud Console → APIs & Services → Credentials.
# Add BOTH of these as "Authorized redirect URIs" on that client (one for
# production, one for local dev — Google allows a plain http://localhost
# redirect URI as a special case):
#   https://api.ecommnode.com/api/google/oauth/callback
#   http://localhost:4000/api/google/oauth/callback
# Also enable "Google Analytics Admin API" and "Google Analytics Data API"
# (for GA4) and "Google Search Console API" (for GSC) on that same Cloud
# project — the OAuth consent screen doesn't need to be "published" for
# your own company's Google accounts to use it (internal/testing mode is
# fine), only if unrelated Google accounts need to connect too.
# CLIENT_ID is not a secret — it's also baked into the frontend build as
# app/.env.production's VITE_GOOGLE_CLIENT_ID (same value), since the
# popup needs it client-side to build Google's consent-screen URL. Same
# "must be committed in app/.env.production, not just a local app/.env"
# reasoning as VITE_META_APP_ID — see CLAUDE.md for the 2026-09-11 incident
# that reasoning is there to prevent.
GOOGLE_CLIENT_ID=
# CLIENT_SECRET, unlike CLIENT_ID, IS a secret — it's what lets this
# server (not the browser) exchange the authorization code Google's popup
# returns for real access/refresh tokens. Never put this in any app/.env*
# file or anywhere else the frontend build could pick it up.
GOOGLE_CLIENT_SECRET=

# Meta inbox ("Poruke") — Messenger, Instagram Direct, WhatsApp Business,
# and Viber webhooks and replies. Also run supabase-inbox-setup.sql +
# supabase-inbox-avatar-fix.sql once in the Supabase SQL editor (uses the
# SUPABASE_* vars above).

# Arbitrary string you invent yourself — enter the same value in the Meta
# App Dashboard's webhook subscription form. Meta echoes it back on the
# GET verification request to prove the request is really from Meta. One
# App (and so one VERIFY_TOKEN/META_APP_SECRET) can cover every Facebook/
# Instagram/WhatsApp brand connected through Podešavanja → Integracije —
# these two are per-App, not per-brand.
VERIFY_TOKEN=

# App ID + secret from Meta App Dashboard → Settings → Basic. Secret
# verifies the X-Hub-Signature-256 header on every inbound webhook POST;
# both are needed for the "Poveži se sa Facebook-om" OAuth flow
# (POST /inbox/oauth/facebook/pages, see lib/metaMessaging.js) to exchange
# the short-lived user token FB.login() returns for real Page tokens. The
# App ID is also NOT a secret — it's baked into the frontend build as
# app/.env's VITE_META_APP_ID (same value), since the Facebook JS SDK
# needs it client-side to open the login popup at all.
META_APP_ID=
META_APP_SECRET=

# Fallback account used only when a brand isn't registered in Podešavanja →
# Integracije (Meta Inbox / WhatsApp Business / Viber cards) — those store
# their own per-brand tokens in server/data/inbox-connections.json instead.
# Fine to leave all of these unset once every brand is connected there.
PAGE_ACCESS_TOKEN=
# IG_PAGE_ACCESS_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Public HTTPS origin this server is reachable at (ngrok URL in dev, real
# domain in production) — e.g. https://a1b2-93-84-xx-xx.ngrok-free.app.
# Used to auto-register each Viber bot's webhook URL when you connect it in
# Podešavanja → Integracije (leave unset and that connection still saves —
# you'll just need to register that bot's webhook URL yourself, shown after
# connecting), AND to build the redirect_uri for the GA4/GSC Google OAuth
# flow above (lib/googleOAuthClient.js) — that one falls back to
# http://localhost:<PORT> when unset, which only works if you registered
# that exact localhost URI on the Google OAuth client too. On the real
# production server this MUST be set to https://api.ecommnode.com (with
# that exact path registered as a Google redirect URI, see above) or
# "Poveži se sa Google nalogom" will fail.
PUBLIC_BASE_URL=

# Eurocom International premium integration (server/premium/eurocom, private
# repo, vendored locally). Set to "true" only on the server that should own
# the automatic schedule (stock every hour, price every 24h from server
# start — plain setInterval, not a fixed clock time) — see CLAUDE.md
# section 3. Never set this on a dev machine connected to a real
# WooCommerce store: a manual sync there and this scheduled run would both
# write to the same external store independently.
EUROCOM_AUTOSYNC=

# Stock-control premium module (server/premium/stock-control) — drafts
# WooCommerce/Shopify products that go out of stock and restores them once
# back in stock. Same "true" only on the one server that owns the schedule,
# same "never on a dev box connected to a real store" reasoning as
# EUROCOM_AUTOSYNC above, and a separate flag on purpose so each
# integration's automatic schedule is opted into independently. Checks once
# every 24h from server start (setInterval), and on boot against each
# connection's own persisted lastRun so a restart doesn't skip an overdue run.
STOCK_CONTROL_AUTOSYNC=
