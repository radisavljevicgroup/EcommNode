VITE_API_BASE_URL=https://api.ecommnode.com/api

# Meta App ID for the Facebook JS SDK (facebookSdk.js) — NOT a secret, the
# SDK needs it client-side to open the login popup at all (see
# server/.env.example's META_APP_ID comment). Committed here (unlike the
# rest of app/.env, which is gitignored) specifically so a production build
# from ANY machine bakes in the real value — see CLAUDE.md for the 2026-09-11
# incident where a rebuild from a machine whose local .env never had this set
# silently baked in an empty app ID, breaking "Poveži se sa Facebook-om" with
# no build error.
VITE_META_APP_ID=4049991195297033

# Supabase URL + anon key — NOT secrets (anon key is public by design and is
# baked into every client bundle anyway; access is enforced by RLS). Committed
# here for the same reason as VITE_META_APP_ID above: on 2026-10-21 a build
# from a clean git worktree (no gitignored app/.env) baked in an empty
# VITE_SUPABASE_URL, and ecommnode.com rendered a blank page
# ("supabaseUrl is required") with no build error.
VITE_SUPABASE_URL=https://iwixrkrsurdpdiamszdw.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_LpC3hM8VZw4mV_io1caFqw_-P2dtsK5

# Browser → Supabase goes through our API (server/routes/supabaseProxy.js):
# on 2026-10-27 Chrome on some networks timed out reaching the
# <project>.supabase.co host directly, so login failed with "Failed to fetch"
# while api.ecommnode.com stayed reachable. Unset = talk to Supabase directly.
VITE_SUPABASE_PROXY_URL=https://api.ecommnode.com/supabase
