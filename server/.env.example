PORT=4000
# Optional: locks CORS to one origin. Leave unset in dev to allow any
# http://localhost:<port> origin (Vite may pick a different port).
# CLIENT_ORIGIN=http://localhost:5173

# Supabase project URL (same value as app/.env's VITE_SUPABASE_URL) and the
# service role (secret) key — Supabase dashboard → Settings → API. Needed
# only for the "add worker" endpoint, which creates auth users and bypasses
# RLS to write into another user's profile row. Never expose this key to
# the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
